# Public runtime config — every EXPO_PUBLIC_* value is inlined into the JS bundle at
# build time. Never put secrets here.
#
# Copy to `.env` for local development. Restart Metro with `npx expo start --clear`
# after changing any value; a plain reload keeps the previously inlined values.

# REST API base URL, including the /api/v1 prefix every route is mounted under.
# Local default: the stocks-advisory-platform server (`npm run dev:server`) on :4000.
#
# In development builds, a `localhost` / `127.0.0.1` host is rewritten at runtime to the
# machine running Metro, so this one value works unchanged on the iOS simulator, the
# Android emulator, and a physical device on the same Wi-Fi. Release builds never
# rewrite, and production builds refuse a non-https URL (see app.config.ts).
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Realtime endpoint (same HTTP server as the REST API).
EXPO_PUBLIC_WS_URL=ws://localhost:4000

# development | preview | production — EAS build profiles set this themselves (eas.json).
EXPO_PUBLIC_APP_ENV=development

EXPO_PUBLIC_ENABLE_BIOMETRICS=true
EXPO_PUBLIC_SENTRY_DSN=
